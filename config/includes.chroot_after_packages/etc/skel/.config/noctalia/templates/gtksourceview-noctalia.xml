<?xml version="1.0" encoding="UTF-8"?>
<!--
 noctalia
 by sleekmason <sleekmason@gmail.com> 
-->
<style-scheme id="noctalia" name="Noctalia" version="1.0">
  <author>Waydog</author>
  <description>Follows the Noctalia palette</description>

  <color name="bg"        value="{{colors.surface.default.hex}}"/>
  <color name="bg_alt"    value="{{colors.surface_container.default.hex}}"/>
  <color name="fg"        value="{{colors.on_surface.default.hex}}"/>
  <color name="fg_dim"    value="{{colors.on_surface_variant.default.hex}}"/>
  <color name="line"      value="{{colors.outline_variant.default.hex}}"/>
  <color name="primary"   value="{{colors.primary.default.hex}}"/>
  <color name="on_primary" value="{{colors.on_primary.default.hex}}"/>
  <color name="secondary" value="{{colors.secondary.default.hex}}"/>
  <color name="tertiary"  value="{{colors.tertiary.default.hex}}"/>
  <color name="error"     value="{{colors.error.default.hex}}"/>

  <!-- Editor -->
  <style name="text"                    foreground="fg" background="bg"/>
  <style name="selection"               foreground="on_primary" background="primary"/>
  <style name="selection-unfocused"     foreground="fg" background="line"/>
  <style name="cursor"                  foreground="fg"/>
  <style name="secondary-cursor"        foreground="fg_dim"/>
  <style name="current-line"            background="bg_alt"/>
  <style name="current-line-number"     foreground="fg" background="bg_alt" bold="true"/>
  <style name="line-numbers"            foreground="fg_dim" background="bg_alt"/>
  <style name="right-margin"            foreground="line" background="bg_alt"/>
  <style name="draw-spaces"             foreground="line"/>
  <style name="background-pattern"      background="bg_alt"/>
  <style name="bracket-match"           foreground="on_primary" background="secondary" bold="true"/>
  <style name="bracket-mismatch"        foreground="fg" background="error"/>
  <style name="search-match"            foreground="on_primary" background="tertiary"/>

  <!-- Syntax -->
  <style name="def:comment"             foreground="fg_dim" italic="true"/>
  <style name="def:shebang"             foreground="fg_dim" bold="true"/>
  <style name="def:doc-comment-element" foreground="fg_dim" bold="true"/>
  <style name="def:string"              foreground="tertiary"/>
  <style name="def:special-char"        foreground="secondary"/>
  <style name="def:keyword"             foreground="primary" bold="true"/>
  <style name="def:statement"           foreground="primary" bold="true"/>
  <style name="def:type"                foreground="secondary" bold="true"/>
  <style name="def:function"            foreground="secondary"/>
  <style name="def:builtin"             foreground="secondary"/>
  <style name="def:constant"            foreground="tertiary"/>
  <style name="def:number"              foreground="tertiary"/>
  <style name="def:boolean"             foreground="tertiary" bold="true"/>
  <style name="def:identifier"          foreground="fg"/>
  <style name="def:preprocessor"        foreground="secondary"/>
  <style name="def:note"                foreground="on_primary" background="secondary" bold="true"/>
  <style name="def:error"               foreground="error" underline="error"/>
  <style name="def:warning"             foreground="tertiary" underline="error"/>
  <style name="def:underlined"          underline="single"/>
  <style name="def:heading"             foreground="primary" bold="true"/>
  <style name="def:emphasis"            italic="true"/>
  <style name="def:strong-emphasis"     bold="true"/>
  <style name="def:link-text"           foreground="secondary" underline="single"/>
  <style name="def:insertion"           foreground="secondary"/>
  <style name="def:deletion"            foreground="error" strikethrough="true"/>
</style-scheme>
