# Dragon colors template

# window title bars and borders
window.active.title.bg.color: {{ colors.surface.default.hex | lighten 7 }}
window.inactive.title.bg.color: {{ colors.surface.default.hex }}
window.active.label.text.color: {{ colors.on_surface.default.hex }}
window.inactive.label.text.color: {{ colors.on_surface_variant.default.hex }}
window.active.border.color: {{ colors.primary.default.hex }}
window.inactive.border.color: {{ colors.outline.default.hex }}

# window buttons
window.active.button.unpressed.image.color: {{ colors.on_surface.default.hex }}
window.inactive.button.unpressed.image.color: {{ colors.on_surface_variant.default.hex }}

# menu
menu.border.color: {{ colors.outline.default.hex }}
menu.items.bg.color: #{{ colors.surface.default.hex_stripped }}E5
menu.items.text.color: {{ colors.on_surface.default.hex }}
menu.items.active.bg.color: {{ colors.primary.default.hex }}
menu.items.active.text.color: {{ colors.on_primary.default.hex }}
menu.separator.color: {{ colors.outline.default.hex | darken 6 }}
menu.title.bg.color: {{ colors.surface_container.default.hex }}
menu.title.text.color: {{ colors.on_surface.default.hex }}

# on screen display (window-cycle dialog)
osd.bg.color: {{ colors.surface.default.hex }}
osd.border.color: {{ colors.outline.default.hex }}
osd.label.text.color: {{ colors.on_surface.default.hex }}
osd.window-switcher.preview.border.color: {{ colors.primary.default.hex }},#000000,{{ colors.primary.default.hex }}
