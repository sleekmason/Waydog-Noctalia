#!/bin/bash
# Restores the dragon theme if a user toggles Noctalias labwc template on/off.

rc="${XDG_CONFIG_HOME:-$HOME/.config}/labwc/rc.xml"
[ -f "$rc" ] || exit 0
xmllint --noout "$rc" 2>/dev/null || exit 0
name=$(xmllint --xpath 'string(/labwc_config/theme/name)' "$rc" 2>/dev/null)
[ -z "$name" ] && sed -i '0,/^[[:space:]]*<theme>[[:space:]]*$/s//&\n    <name>waydog<\/name>/' "$rc"
pgrep -x labwc >/dev/null && labwc --reconfigure
