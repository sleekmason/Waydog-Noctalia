#!/bin/bash
read -p "   [0;33mWayfire Compositor Installer[0m

   Wayfire is a 3D Wayland compositor inspired by Compiz and based
   on wlroots. It aims to create a customizable, extendable and
   lightweight environment without sacrificing appearance.
   
   This script will install Wayfire, and wf-shell to provide panel
   support. Custom configurations will be added to ~/.config for
   wayfire and wf-shell customizations.
   
   
   [0;34mhttps://wayfire.org/[0m
   
   
   [0;32m---------------------------------------------------------------

   Please press enter to install the Wayfire Compositor.

   ---------------------------------------------------------------[0m

   Or, close this terminal window to quit the install." ;
## Make sure of internet connection.
if : >/dev/tcp/8.8.8.8/53; then
echo ""
cd /tmp || exit
rm -f "wayfire-0.10.0.zip"
rm -fr "wayfire"
wget --prefer-family=IPv4 https://raw.githubusercontent.com/sleekmason/packages/master/wayfire-0.10.0.zip --show-progress -q || exit
unzip -q "/tmp/wayfire-0.10.0.zip"

sudo apt update && \
sudo apt install -y \
/tmp/wayfire/libwlroots-0.19_0.19.3-wd1_amd64.deb \
/tmp/wayfire/wayfire_0.10.0-wd1_amd64.deb || exit

sudo apt install -y cbatticon upower

backup_item=("wayfire.ini")

for item in "${backup_items[@]}"; do
    src="$HOME/.config/$item"
    bak="$HOME/.config/$item.bak"

    if [ -e "$src" ]; then
        if [ -e "$bak" ]; then
            if [ -d "$bak" ]; then
                rm -rf "$bak"
            else
                rm -f "$bak"
            fi
        fi

        cp -r "$src" "$bak"
    fi
done

cp -f "/tmp/wayfire/wayfire.ini" "$HOME/.config"
sudo cp -f "/tmp/wayfire/wayfire-keys.sh" "/usr/local/bin"

LAYOUT=$(grep '^XKBLAYOUT=' /etc/default/keyboard | cut -d'"' -f2)
[[ -z "$LAYOUT" ]] && LAYOUT="us"
sed -i "s|^# *xkb_layout = .*|xkb_layout = $LAYOUT|" "$HOME/.config/wayfire.ini"

CONF="$HOME/.config/wayfire.ini"
sed -i -E 's|^nm-applet = nm-applet$|# &|' "$CONF"
sed -i -E 's|^autostart_wf_shell = true$|autostart_wf_shell = false|' "$CONF"
grep -q '^noctalia = noctalia$' "$CONF" || sed -i '/^\[autostart\]$/a noctalia = noctalia' "$CONF"

## Explain items.
echo "   [0;32m--------------------------------------------------------[0m"
echo ""
echo "   [0;33mAll Finished![0m"
echo ""
echo "   [0;32mYou should find a new login entry for Wayfire.[0m"
echo ""
echo "   [0;32m--------------------------------------------------------[0m"
echo ""
else
echo ""
 echo "   [0;31m-----------------------------------------------------[0m"
 echo ""
 echo "   [0;33mNo Internet connection. Please connect and try again.[0m"
 echo ""
 echo "   [0;31m-----------------------------------------------------[0m"
echo ""
fi
read -n1 -p " Press any key to quit this dialog ... "
