#!/bin/bash
# Wrapper for adding environmental variables for pkexec usage and theme
# changes for root, with one dbus session for root app use until reboot.

G3="$HOME/.config/gtk-3.0"; G4="$HOME/.config/gtk-4.0"
T=$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'")

pkexec env \
    XDG_SESSION_TYPE="$XDG_SESSION_TYPE" \
    WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
    XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    GIO_USE_VFS=local \
    GIO_USE_VOLUME_MONITOR=unix \
    ${T:+GTK_THEME="$T"} \
    sh -c '
        for p in "$1:gtk-3.0" "$2:gtk-4.0"; do
            src=${p%:*}; dst=/root/.config/${p##*:}
            [ -f "$src/noctalia.css" ] || continue
            mkdir -p "$dst"
            cat "$src/noctalia.css" "$src/waydog-colors.css" 2>/dev/null | grep -v "@import" > "$dst/gtk.css.tmp" &&
                mv -f "$dst/gtk.css.tmp" "$dst/gtk.css" || rm -f "$dst/gtk.css.tmp"
        done
        S=/root/.cache/dbus-root-bus; A="unix:path=$S"
        dbus-send --bus="$A" --dest=org.freedesktop.DBus / org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1 ||
            { mkdir -p /root/.cache; rm -f "$S"; env -u XDG_RUNTIME_DIR dbus-daemon --session --fork --address="$A"; }
        shift 2
        DBUS_SESSION_BUS_ADDRESS="$A" exec "$@"
    ' sh "$G3" "$G4" "$@"
