#!/bin/bash
# accent tuner - Changes accent brightness to reduce glare and give
# more control to the user. made by sleekmason 6 Nov. 2026

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
TD="$CFG/noctalia/templates"
T3="$TD/waydog-gtk3.css"
T4="$TD/waydog-gtk4.css"
TL="$TD/labwc-themerc"
D3="$CFG/gtk-3.0"
N="$D3/noctalia.css"
REV="$CFG/noctalia/accent-tuner-reverse"

get_pct() {
    local f
    f=$(sed -n 's/.*primary\.default\.hex}}, *\([0-9.]*\)).*/\1/p' "$T3" 2>/dev/null | head -1)
    awk -v f="${f:-1.00}" 'BEGIN{printf "%d", f*100+0.5}'
}

filter_for() {
    local a b
    a=$(sed -n 's/^@define-color accent_bg_color #\([0-9a-fA-F]\{6\}\);.*/\1/p' "$N" 2>/dev/null | head -1)
    b=$(sed -n 's/^@define-color window_bg_color #\([0-9a-fA-F]\{6\}\);.*/\1/p' "$N" 2>/dev/null | head -1)
    [ -n "$a" ] && [ -n "$b" ] && [ "$1" -lt 100 ] || return
    awk -v a="$a" -v b="$b" -v p="$1" '
        function hx(s) { return index("0123456789abcdef", tolower(s)) - 1 }
        function ch(h, i) { return (hx(substr(h, i, 1)) * 16 + hx(substr(h, i + 1, 1))) / 255 }
        BEGIN {
            f = p / 100
            r = ch(b,1) * (1 - f) + ch(a,1) * f
            g = ch(b,3) * (1 - f) + ch(a,3) * f
            bl = ch(b,5) * (1 - f) + ch(a,5) * f
            mx = r; if (g > mx) mx = g; if (bl > mx) mx = bl
            mn = r; if (g < mn) mn = g; if (bl < mn) mn = bl
            L = (mx + mn) / 2; d = mx - mn; S = 0; H = 0
            if (d > 0) {
                S = (L <= 0.5) ? d / (mx + mn) : d / (2 - mx - mn)
                if (r == mx) H = (g - bl) / d; else if (g == mx) H = 2 + (bl - r) / d; else H = 4 + (r - g) / d
                H *= 60; if (H < 0) H += 360
            }
            printf "%d %d %d\n", H + 0.5, S * 100 + 0.5, L * 100 + 0.5
        }'
}

fg_filter() {
    local h r g b mx mn dark want
    h=$(sed -n 's/^@define-color accent_fg_color #\([0-9a-fA-F]\{6\}\);.*/\1/p' "$N" 2>/dev/null | head -1)
    [ -n "$h" ] || return
    r=$((16#${h:0:2})); g=$((16#${h:2:2})); b=$((16#${h:4:2}))
    mx=$r; (( g > mx )) && mx=$g; (( b > mx )) && mx=$b
    mn=$r; (( g < mn )) && mn=$g; (( b < mn )) && mn=$b
    (( mx + mn < 255 )) && dark=1 || dark=0
    want=$dark; [ -f "$REV" ] && want=$(( 1 - dark ))
    if (( want )); then
        (( dark )) && echo " | desaturate 100 | darken 9" || echo " | desaturate 100 | set_lightness 4"
    else
        (( dark )) && echo " | desaturate 100 | set_lightness 97"
    fi
}

rebuild_colors() {
    [ -f "$N" ] && [ -f "$D3/waydog-colors.css" ] &&
        cat "$N" "$D3/waydog-colors.css" > "$D3/colors.css.tmp" && mv -f "$D3/colors.css.tmp" "$D3/colors.css"
}

apply() {
    local p="$1" f t h s l new changed=0
    f=$(awk -v p="$p" 'BEGIN{printf "%.2f", p/100}')

    for t in "$T3" "$T4"; do
        [ -f "$t" ] || continue
        if ! grep -q "primary\.default\.hex}}, $f)" "$t"; then
            sed -i "s/\(primary\.default\.hex}}, *\)[0-9.]*/\1$f/g" "$t"
            changed=1
        fi
    done
    
    fg=$(fg_filter)
    want="{{colors.on_primary.default.hex$fg}}"
    for t in "$T3" "$T4"; do
        [ -f "$t" ] || continue
        grep -qF "$want" "$t" && continue
        sed -i "s/{{colors\.on_primary\.default\.hex[^}]*}}/$want/g" "$t"
        changed=1
    done
    if [ -f "$TL" ]; then
        newt="menu.items.active.text.color: {{ colors.on_primary.default.hex$fg }}"
        grep -qxF "$newt" "$TL" || { sed -i "s/^menu.items.active.text.color:.*/$newt/" "$TL"; changed=1; }
    fi

    if [ -f "$TL" ]; then
        read -r h s l < <(filter_for "$p")
        new="menu.items.active.bg.color: {{ colors.primary.default.hex"
        [ -n "$l" ] && new+=" | set_hue $h | set_saturation $s | set_lightness $l"
        new+=" }}"
        if ! grep -qxF "$new" "$TL"; then
            sed -i "s/^menu.items.active.bg.color:.*/$new/" "$TL"
            changed=1
        fi
    fi

    rebuild_colors
        rebuild_colors
    ( for i in $(seq 20); do
          [ "$N" -nt "$D3/waydog-colors.css" ] || break
          sleep 0.1
      done
      rebuild_colors ) &
    if [ "$changed" -eq 1 ]; then
        noctalia msg templates-apply >/dev/null 2>&1
        ( sleep 1; rebuild_colors
          pgrep -x labwc >/dev/null && { labwc --reconfigure 2>/dev/null || pkill -HUP -x labwc; } ) &
    fi
}

if [ "$1" = "--apply" ]; then
    apply "$(get_pct)"
    exit 0
fi

pct=$(get_pct)
    rev=FALSE; [ -f "$REV" ] && rev=TRUE
    out=$(yad --form --title="Accent Tuner" --window-icon=preferences-desktop-theme \
        --width=340 --height=138 --borders=10 --center \
        --field="Current brightness (%)     :NUM" "$pct!40..100!1" \
        --field=" Reverse text color:CHK" "$rev" \
        --button="Apply!gtk-okay:2" --button="Close!gtk-close:1" 2>/dev/null)
    [ $? -eq 2 ] || exit 0
    IFS='|' read -r val r _ <<< "$out"
    val=${val%%.*}
    (( val < 40 )) && val=40
    [ "$r" = TRUE ] && touch "$REV" || rm -f "$REV"

    apply "$val"
