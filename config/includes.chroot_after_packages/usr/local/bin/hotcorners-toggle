#!/bin/bash
# Hotcorners toggle for noctalia
# Made by sleekmason 31 Oct 2026

hot_toggle="hot_corners.enabled"
if [ "$(noctalia msg config-get "$hot_toggle")" = "true" ]; then
    noctalia msg config-set "$hot_toggle" false
    notify-send -i preferences-desktop "Hotcorners disabled"
else
    noctalia msg config-set "$hot_toggle" true
    notify-send -i preferences-desktop "Hotcorners enabled"
fi
